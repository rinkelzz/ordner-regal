
# --- preinst: prüft vor der Installation, ob ein passendes Python da ist

if [ -z "$(find_python)" ]; then
    cat >> "${SYNOPKG_TEMP_LOGFILE:-/dev/stdout}" <<'EOF'
Kein passendes Python gefunden. Bitte zuerst im Paket-Zentrum „Python 3.9" installieren (oder Python 3.11/3.12 von SynoCommunity) und danach das Ordner-Regal erneut installieren.
EOF
    exit 1
fi
case "$(cpu_name "$(find_python | cut -d' ' -f1)")" in
    x86_64|aarch64|armv7l) ;;
    *)
        echo "Dieser Prozessor ($(uname -m)) wird nicht unterstützt – nur Intel/AMD (x86_64) und ARM (ARMv7, ARMv8)." \
            >> "${SYNOPKG_TEMP_LOGFILE:-/dev/stdout}"
        exit 1 ;;
esac
# Nur bei Neuinstallation: Ist der gewählte Port frei? (Beim Update läuft die alte Version noch darauf.)
if [ "${SYNOPKG_PKG_STATUS:-INSTALL}" != "UPGRADE" ]; then
    PORT="${wizard_port:-8800}"
    case "$PORT" in ''|*[!0-9]*) PORT=8800 ;; esac
    PY=$(find_python | cut -d' ' -f1)
    if ! port_is_free "$PY" "$PORT"; then
        WHO=$(port_owner "$PORT")
        {
            echo "Port ${PORT} ist auf dieser NAS schon belegt${WHO:+ (von: ${WHO})}. Bitte die Installation erneut starten und im Assistenten einen anderen Port eintragen – zum Beispiel $(next_free_port "$PY" "$PORT")."
            echo "Oft schon belegt: 8765 (Zeiterfassung), 8770 (Zeitmanagement), 8780 (IT-Dokumentation), 8790 (Foto-Globus)."
        } >> "${SYNOPKG_TEMP_LOGFILE:-/dev/stdout}"
        exit 1
    fi
fi
exit 0
