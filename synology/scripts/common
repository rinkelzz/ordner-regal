# Gemeinsame Funktionen – wird beim Bau oben in jedes Skript eingefügt.
PKG="ordnerregal"
PKGDEST="${SYNOPKG_PKGDEST:-/var/packages/${PKG}/target}"
PKGVAR="${SYNOPKG_PKGVAR:-/var/packages/${PKG}/var}"
CONFIG="${PKGVAR}/config.env"
PIDFILE="${PKGVAR}/${PKG}.pid"
LOGFILE="${PKGVAR}/${PKG}.log"
SUPPORTED="cp313 cp312 cp311 cp310 cp39 cp38"

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "${LOGFILE}" 2>/dev/null
}

# Sucht das neueste Python, für das Bibliotheken im Paket liegen und das
# sqlite3 + ssl mitbringt. Gibt "PFAD TAG" aus.
find_python() {
    candidates="${ORG_PYTHON:-}"
    for p in /var/packages/python3*/target/bin/python3.* \
             /var/packages/Python3*/target/usr/bin/python3.* \
             /var/packages/Python3*/target/bin/python3.* \
             /usr/local/bin/python3.* /usr/local/bin/python3 \
             /usr/bin/python3.* /usr/bin/python3 /bin/python3; do
        case "$p" in *-config|*m-config) continue ;; esac
        [ -x "$p" ] && candidates="$candidates $p"
    done
    best=""; best_tag=""; best_rank=99
    for py in $candidates; do
        tag=$("$py" -c 'import sys, sqlite3, ssl; print("cp%d%d" % sys.version_info[:2])' 2>/dev/null) || continue
        rank=0
        for s in $SUPPORTED; do
            if [ "$s" = "$tag" ]; then
                if [ $rank -lt $best_rank ]; then best="$py"; best_tag="$tag"; best_rank=$rank; fi
                break
            fi
            rank=$((rank + 1))
        done
    done
    [ -n "$best" ] && echo "$best $best_tag"
}

# Prozessor so benennen wie die Ordner im Paket (lib/<cp>-<prozessor>)
cpu_name() {
    m=$("$1" -c 'import platform; print(platform.machine())' 2>/dev/null || uname -m)
    case "$m" in
        x86_64|amd64|AMD64) echo x86_64 ;;
        aarch64|arm64|armv8) echo aarch64 ;;
        armv7*|armv8l) echo armv7l ;;
        *) echo "$m" ;;
    esac
}

# PYTHONPATH für Python $1 (Tag $2) – leer, wenn dieser Prozessor nicht unterstützt wird
lib_path() {
    cpu=$(cpu_name "$1")
    [ -d "${PKGDEST}/lib/$2-${cpu}" ] && [ -d "${PKGDEST}/lib/$2" ] && \
        echo "${PKGDEST}/lib/$2-${cpu}:${PKGDEST}/lib/$2:${PKGDEST}"
}

# Ist der TCP-Port $2 frei? (kurz belegen und wieder freigeben, wie die App selbst; $1 = Python)
port_is_free() {
    "$1" -c 'import socket, sys
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
try:
    s.bind(("0.0.0.0", int(sys.argv[1])))
except OSError:
    sys.exit(1)
finally:
    s.close()' "$2" >/dev/null 2>&1
}

# Nächster freier Port ab $2 + 10 (für den Hinweis)
next_free_port() {
    p=$(( $2 + 10 )); i=0
    while [ $i -lt 50 ]; do
        port_is_free "$1" "$p" && { echo "$p"; return; }
        p=$((p + 1)); i=$((i + 1))
    done
    echo "8850"
}

# Welches Programm lauscht auf Port $1? (leer, wenn nicht ermittelbar)
port_owner() {
    command -v netstat >/dev/null 2>&1 || return 0
    netstat -tlnp 2>/dev/null | awk -v p=":$1" '$4 ~ p"$" {n = split($7, a, "/"); if (n > 1) print a[2]; exit}'
}
